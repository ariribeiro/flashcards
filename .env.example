# Firebase (Console → Configurações do projeto → Seus apps → app Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (Google Cloud Console → Credenciais)
# "Web client" criado automaticamente pelo Firebase ao ativar o provedor Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Cliente OAuth do tipo iOS (bundle id do app)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# "Reversed client ID" do cliente iOS (com.googleusercontent.apps.XXXX), usado no URL scheme
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Desenvolvimento local com o Firebase Emulator Suite (npx firebase-tools emulators:start)
# EXPO_PUBLIC_USE_EMULATORS=1

# 0 = build para conta Apple gratuita (Xcode / Personal Team): remove o Sign in with Apple
# EXPO_PUBLIC_APPLE_SIGNIN=0
